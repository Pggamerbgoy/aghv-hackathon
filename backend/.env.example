# Server Configuration
PORT=4000
NODE_ENV=development

# Security & Redaction (Dev bypass flag if evaluating without live Firebase Auth)
ENABLE_DEV_AUTH_BYPASS=true

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# GitHub Access (Optional for public repos, recommended to bypass rate limits)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# AI Service (Google Gemini API)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Optional Redis URL (System automatically falls back to in-memory worker if Redis is unavailable)
REDIS_URL=redis://localhost:6379
